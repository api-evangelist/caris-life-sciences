  "info": {
    "_postman_id": "51aae0a3-603a-4f48-ac61-19e62dd97154",
    "name": "Caris Life Sciences (Public Surface) Information API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Caris Life Sciences does not publish a public, self-serve developer API or machine-readable API reference. This OpenAPI document is a minimal, factual placeholder describing only the publicly reachable web surfaces of Caris's clinician and partner products. No third-party developer JSON/REST endpoints are documented by Caris, and none have been invented here.\nClinician ordering, case tracking, and results review happen through the browser-based Caris+Portal (https://portal.caris.ai). Electronic ordering and results delivery into EHRs (Epic Orders and Results Anywhere, OncoEMR/Flatiron, iKnowMed, and other CMS-certified systems) is provisioned per-partner through standards-based lab order/result interfaces. The CODEai clinico-genomic data platform is made available to biopharma and academic researchers under contract. Access to all of these is onboarding- or contract-based, not open developer sign-up.\n\nContact Support:\n Name: Caris Life Sciences Customer Support\n Email: CustomerSupport@CarisLS.com",
      "type": "text/plain"
    }
  }
